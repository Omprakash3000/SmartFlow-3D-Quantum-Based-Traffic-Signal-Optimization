# SmartFlow3D Backend Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=info

# Simulation Defaults
SIMULATION_DT=0.5
DEFAULT_SPEED_LIMIT_MPS=13.89
MAX_SIMULATION_STEPS=3600

# Optimization Settings
QAOA_MAX_ITER=30
QAOA_REPS=1
OPTIMIZATION_TIMEOUT_SECONDS=15
USE_HARDWARE_BACKEND=false
QUANTUM_PROVIDER=aer_simulator
